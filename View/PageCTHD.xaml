<UserControl x:Class="Page_Navigation_App.View.PageCTHD"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Page_Navigation_App.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White">
    <Grid>
        <Label Content="Mã khách hàng:" HorizontalAlignment="Left" Margin="54,104,0,0" VerticalAlignment="Top" Width="133" FontSize="16" FontWeight="Bold"/>
        <TextBox HorizontalAlignment="Left" Margin="232,104,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="105" Height="31"/>
        <DockPanel HorizontalAlignment="Center" Height="81" LastChildFill="False" 
            VerticalAlignment="Top" Width="800"
            Background="#213448">
            <Label Content="Tạo hoá đơn thành công" Width="465" Height="69"
            Foreground="#F4F4F4" FontSize="36" FontFamily="Arial" FontWeight="Bold"/>
        </DockPanel>
        <Label Content="Tên khách hàng:" HorizontalAlignment="Left" Margin="54,164,0,0" VerticalAlignment="Top" Width="142" RenderTransformOrigin="0.216,0.365" FontSize="16" FontWeight="Bold"/>
        <TextBox HorizontalAlignment="Left" Margin="232,164,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="187" Height="34"/>

        <Label Content="Tổng tiền:" HorizontalAlignment="Left" Margin="454,104,0,0" VerticalAlignment="Top" Width="106" FontSize="16" FontWeight="Bold"/>
        <TextBox HorizontalAlignment="Left" Height="31" Margin="609,104,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="168"/>
        <TextBox HorizontalAlignment="Left" Margin="609,164,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="168" Height="34"/>
        <Label Content="Giam giá" HorizontalAlignment="Left" Margin="458,164,0,0" VerticalAlignment="Top" FontSize="16" FontWeight="Bold" Width="98"/>
        <Label Content="Thành tiền:" HorizontalAlignment="Left" Margin="454,225,0,0" VerticalAlignment="Top" Width="177" FontSize="16" FontWeight="Bold"/>
        <TextBox HorizontalAlignment="Left" Margin="609,225,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="168" Height="31"/>
        <Button Content="OK" HorizontalAlignment="Left" Margin="661,392,0,0"
         VerticalAlignment="Top" Width="86" Height="29" 
         RenderTransformOrigin="0.515,0.262" Background="#FFF57E" Click="Button_Click"/>
        <StatusBar HorizontalAlignment="Left"
    Height="74"
    Margin="454,287,0,0"
    VerticalAlignment="Top"
    Width="323"
    Background="White">

            <StatusBarItem>
                <TextBlock x:Name="txtInvoiceTime"
            Foreground="Black"
            FontSize="16"
            FontWeight="Bold"
            Text="Hóa đơn được tạo vào:" Width="184"/>
            </StatusBarItem>

        </StatusBar>

        <ListView HorizontalAlignment="Left" Height="181" Margin="54,240,0,0" VerticalAlignment="Top" Width="378" d:ItemsSource="{d:SampleData ItemCount=5}" RenderTransformOrigin="0.472,0.472">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Danh sách mặt hàng" Width="283"/>
                    <GridViewColumn Header="Số lượng"/>
                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</UserControl>
