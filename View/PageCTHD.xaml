<UserControl x:Class="Page_Navigation_App.View.PageCTHD"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB">

    <Grid Margin="20">

        <Border Background="White"
                CornerRadius="18"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="#213448"
                        CornerRadius="14"
                        Padding="15">

                    <TextBlock Text="Tạo hoá đơn thành công"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Content -->
                <Grid Grid.Row="1" Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left -->
                    <Border Grid.Column="0"
                            Background="#F1F5F9"
                            CornerRadius="14"
                            Padding="16"
                            Margin="0,0,15,0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Thông tin khách hàng"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"/>

                            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                <TextBlock Text="Mã khách hàng" FontWeight="Bold"/>
                                <TextBox Height="32"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <TextBlock Text="Tên khách hàng" FontWeight="Bold"/>
                                <TextBox Height="32"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock Text="Số điện thoại" FontWeight="Bold"/>
                                <TextBox Height="32"/>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <!-- Right -->
                    <Border Grid.Column="1"
                            Background="#F1F5F9"
                            CornerRadius="14"
                            Padding="16">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Danh sách mặt hàng"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"/>

                            <!-- LISTVIEW GIỮ NGUYÊN -->
                            <Border Grid.Row="1"
                                    Background="White"
                                    CornerRadius="12"
                                    Padding="8">

                                <ListView Height="200">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Danh sách mặt hàng" Width="220"/>
                                            <GridViewColumn Header="Số lượng" Width="80"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                            </Border>

                            <!-- Total -->
                            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Tổng tiền:" Width="120" FontWeight="Bold"/>
                                    <TextBox Width="150" Height="30"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Giảm giá:" Width="120" FontWeight="Bold"/>
                                    <TextBox Width="150" Height="30"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Thành tiền:" Width="120" FontWeight="Bold"/>
                                    <TextBox Width="150" Height="30"/>
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </Border>

                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StatusBar Grid.Column="0" Background="Transparent">
                        <StatusBarItem>
                            <TextBlock x:Name="txtInvoiceTime"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Text="Hóa đơn được tạo vào:"/>
                        </StatusBarItem>
                    </StatusBar>

                    <Button Grid.Column="1"
                            Content="OK"
                            Width="100"
                            Height="36"
                            Background="#22C55E"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand" Click="Button_Click_1"/>
                </Grid>

            </Grid>
        </Border>

    </Grid>
</UserControl>
