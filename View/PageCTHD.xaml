<UserControl x:Class="Page_Navigation_App.View.PageCTHD"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB">

    <Grid Margin="20">
        <Border Background="White"
                CornerRadius="18"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Border Grid.Row="0"
                        Background="#213448"
                        CornerRadius="14"
                        Padding="15">
                    <TextBlock Text="Tạo hoá đơn thành công"
                               FontFamily="{StaticResource Open Sans}"
                               FontSize="32"
                               FontWeight="ExtraBold"
                               Foreground="White"/>
                </Border>

                <!-- CONTENT -->
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KHÁCH HÀNG -->
                    <Border Grid.Column="0"
                            Background="#F1F5F9"
                            CornerRadius="14"
                            Padding="16"
                            Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Thông tin khách hàng"
                                       FontFamily="{StaticResource Open Sans}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Mã hóa đơn"/>
                            <TextBox Text="{Binding MaHD}" IsReadOnly="True"/>

                            <TextBlock Text="Tên khách hàng" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding TenKH}" IsReadOnly="True"/>

                            <TextBlock Text="Số điện thoại" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding SDT}" IsReadOnly="True"/>
                        </StackPanel>
                    </Border>

                    <!-- CHI TIẾT -->
                    <Border Grid.Column="1"
                            Background="#F1F5F9"
                            CornerRadius="14"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Danh sách mặt hàng"
                                       FontFamily="{StaticResource Open Sans}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding ChiTietHoaDon}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Tên SP" Width="200"
                                                        DisplayMemberBinding="{Binding TenSP}"/>
                                        <GridViewColumn Header="SL" Width="60"
                                                        DisplayMemberBinding="{Binding SoLuong}"/>
                                        <GridViewColumn Header="Đơn giá" Width="100"
                                                        DisplayMemberBinding="{Binding DonGia}"/>
                                        <GridViewColumn Header="Thành tiền" Width="120"
                                                        DisplayMemberBinding="{Binding ThanhTien}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="Tổng tiền:" FontFamily="{StaticResource Open Sans}" FontWeight="Bold"/>
                                <TextBox Width="160"
                                         Margin="10,0,0,0"
                                         Text="{Binding TongTien}"
                                         IsReadOnly="True"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- FOOTER -->
                <Grid Grid.Row="2">
                    <TextBlock Text="{Binding NgayLap,
                        StringFormat=Hóa đơn tạo lúc {0:dd/MM/yyyy HH:mm}}"/>

                    <Button Content="OK"
                            HorizontalAlignment="Right"
                            Width="110"
                            Click="Button_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
