<UserControl x:Class="Page_Navigation_App.View.PageThemNhapHang"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White"
             Width="900"
             Height="520">

    <Border BorderBrush="#1E90FF" BorderThickness="2" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

          
            <Border Grid.Row="0" Background="#203A52">
                <TextBlock Text="THÊM NHẬP HÀNG"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>

            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="30">

                    <TextBlock Text="Thông tin lô nhập"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,10">
                            <TextBlock Text="Mã lô"/>
                            <TextBox x:Name="txtMaNH" Height="32"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Ngày nhập"/>
                            <DatePicker x:Name="dpNgayNhap" Height="32"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,10">
                            <TextBlock Text="Mã NCC"/>
                            <TextBox x:Name="txtMaNCC" Height="32"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="Tên NCC"/>
                            <TextBox x:Name="txtTenNCC" Height="32"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="SĐT"/>
                            <TextBox x:Name="txtSDT" Height="32"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="Hạn sử dụng"/>
                            <DatePicker x:Name="dpHSD" Height="32"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Chi tiết lô hàng"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,10,0,10"/>

                    <DataGrid x:Name="dgChiTiet"
                              Height="220"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã sản phẩm"
                                                Binding="{Binding MaSP, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Số lượng"
                                                Binding="{Binding SoLuongNhapHang, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Đơn giá"
                                                Binding="{Binding GiaNhap, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Thành tiền"
                                                Binding="{Binding ThanhTien}"
                                                IsReadOnly="True"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </ScrollViewer>

            <!-- FOOTER -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,30,10">

                <Button Content="Lưu"
                        Width="100"
                        Height="36"
                        Margin="0,0,10,0"
                        Background="#1E90FF"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnLuu_Click"/>

                <Button Content="Hủy"
                        Width="100"
                        Height="36"
                        Background="Gray"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="Button_Click_1"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

