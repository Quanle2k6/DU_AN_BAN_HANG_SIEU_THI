<UserControl x:Class="Page_Navigation_App.View.PageThemNhapHang"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#213448">
            <Label Content="Thêm chi tiết nhập hàng"
                   Foreground="White"
                   FontSize="32"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="20,0"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <Label Content="Mã nhập hàng" FontWeight="Bold"/>
                <TextBox Height="30"/>

                <Label Content="Tên nhà cung cấp" FontWeight="Bold" Margin="0,10,0,0"/>
                <TextBox Height="30"/>

                <Label Content="Số điện thoại" FontWeight="Bold" Margin="0,10,0,0"/>
                <TextBox Height="30"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Label Content="Tổng tiền" FontWeight="Bold"/>
                <TextBox Height="30"/>

                <Label Content="Thành tiền" FontWeight="Bold" Margin="0,10,0,0"/>
                <TextBox Height="30"/>

                <Label Content="Thời gian nhập kho" FontWeight="Bold" Margin="0,10,0,0"/>
                <DatePicker Height="30"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="2" Header="Danh sách mặt hàng nhập kho" Margin="20">
            <StackPanel>

                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Height="30" Margin="5"/>
                    <TextBox Grid.Column="1" Height="30" Margin="5"/>
                    <DatePicker Grid.Column="2" Height="30" Margin="5"/>
                    <Button Grid.Column="3" Content="Thêm" Padding="15,5" Margin="5"/>
                </Grid>

                <DataGrid Height="200"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Width="50"/>
                        <DataGridTextColumn Header="Tên mặt hàng" Width="*"/>
                        <DataGridTextColumn Header="Số lượng" Width="100"/>
                        <DataGridTextColumn Header="Hạn sử dụng" Width="150"/>
                        <DataGridTemplateColumn Header="Xóa" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="X"
                                            Background="Red"
                                            Foreground="White"
                                            Width="30"
                                            Height="25"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>
        </GroupBox>

        <Button Grid.Row="3"
                Content="OK"
                Width="100"
                Height="35"
                HorizontalAlignment="Right"
                Margin="0,10,20,10"
                Background="#FFF57E"
                FontWeight="Bold"/>
        <Button Content="Thoát" HorizontalAlignment="Left" Margin="43,9,0,18" Grid.Row="3" Width="130" FontSize="16" FontWeight="Bold" Foreground="Red"  Background="#FFF57E" Click="Button_Click_1"/>
    </Grid>
</UserControl>
