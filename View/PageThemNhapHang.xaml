<UserControl x:Class="Page_Navigation_App.View.PageThemNhapHang"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="900"
             d:DesignHeight="450">

    <Border BorderBrush="#1E90FF" BorderThickness="2" CornerRadius="4" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="#203A52">
                <TextBlock Text="Thêm Chi Tiết nhập hàng"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- LEFT -->
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,10,40,10">
                    <TextBlock Text="Mã khách hàng:" FontSize="16" FontWeight="Bold"/>
                    <TextBox Height="30" Margin="0,5,0,15"/>

                    <TextBlock Text="Tên khách hàng:" FontSize="16" FontWeight="Bold"/>
                    <TextBox Height="30" Margin="0,5,0,15"/>
                </StackPanel>

                <!-- RIGHT -->
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,10">
                    <TextBlock Text="Tổng tiền:" FontSize="16" FontWeight="Bold"/>
                    <TextBox Height="30" Margin="0,5,0,15"/>

                    <TextBlock Text="Giảm giá:" FontSize="16" FontWeight="Bold"/>
                    <TextBox Height="30" Margin="0,5,0,15"/>

                    <TextBlock Text="Thành tiền:" FontSize="16" FontWeight="Bold"/>
                    <TextBox Height="30" Margin="0,5,0,15"/>
                </StackPanel>

                <!-- BUTTON -->
                <Button Grid.Column="1"
                        Grid.Row="3"
                        Content="OK"
                        Width="90"
                        Height="35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,10"
                        Background="#FFF176"
                        FontWeight="Bold"
                        Click="Button_Click"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
