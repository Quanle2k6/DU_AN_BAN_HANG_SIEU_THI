<UserControl x:Class="Page_Navigation_App.View.Transactions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Page_Navigation_App.ViewModel">

    
    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#4F6BED"/>
        <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="2"
                                      Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ================= VIEWMODEL ================= -->
    <UserControl.DataContext>
        <vm:TransactionVM/>
    </UserControl.DataContext>

    <!-- ================= LAYOUT ================= -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Quản lý nhập kho"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="#1F2937"/>

        
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,20,0,0">
            <Button x:Name="btnThem" Content="➕ Thêm"
                    Background="{StaticResource PrimaryColor}"
                    Style="{StaticResource ModernButton}"
                    Margin="0,0,10,0" Click="btnThem_Click"/>

            <Button x:Name="btnChinhSua" Content="✏️ Chỉnh sửa"
                    Background="{StaticResource PrimaryColor}"
                    Style="{StaticResource ModernButton}"
                    Margin="0,0,10,0" Click="btnChinhSua_Click"/>

            <Button x:Name="btnXoa" Content="🗑 Xoá"
                    Background="{StaticResource DangerColor}"
                    Style="{StaticResource ModernButton}" Click="btnXoa_Click"/>
        </StackPanel>

      
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackPanel Orientation="Horizontal">

                <ComboBox Width="200"
                          Height="32"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding DanhSachNhapHang}"
                          DisplayMemberPath="MaNH"
                          SelectedItem="{Binding NhapHangDangChon}"/>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Từ ngày" FontSize="12"/>
                    <DatePicker Width="140"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Đến ngày" FontSize="12"/>
                    <DatePicker Width="140"/>
                </StackPanel>

                <Button Content="Lấy dữ liệu"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource PrimaryColor}"
                        Style="{StaticResource ModernButton}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding DanhSachNhapHang}"
                      SelectedItem="{Binding NhapHangDangChon}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      RowHeight="40">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Mã nhập hàng"
                                        Binding="{Binding MaNH}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Mã nhà cung cấp"
                                        Binding="{Binding MaNCC}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Tên nhà cung cấp"
                                        Binding="{Binding TenNCC}"
                                        Width="260"/>

                    <DataGridTextColumn Header="Số tài khoản"
                                        Binding="{Binding SoTaiKhoan}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Ngày giao hàng"
                                        Binding="{Binding NgGiao, StringFormat=dd/MM/yyyy}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Hạn sử dụng"
                                        Binding="{Binding HSD, StringFormat=dd/MM/yyyy}"
                                        Width="150"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Height="250">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Chi tiết lô hàng"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ChiTietNhapHangs}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          GridLinesVisibility="None"
                          RowHeight="38">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã sản phẩm"
                                            Binding="{Binding MaSP}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Số lượng"
                                            Binding="{Binding SoLuongNhapHang}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Đơn giá"
                                            Binding="{Binding GiaNhap}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Thành tiền"
                                            Binding="{Binding ThanhTien}"
                                            Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
