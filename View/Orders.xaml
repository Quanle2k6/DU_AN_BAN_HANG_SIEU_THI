<UserControl x:Class="Page_Navigation_App.View.Orders"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Page_Navigation_App.ViewModel"
             Background="#EEF6F4">

    <UserControl.DataContext>
        <vm:OrderVM/>
    </UserControl.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Chi tiết hoá đơn"
                       FontFamily="{StaticResource Open Sans}"
                       FontSize="30"
                       FontWeight="ExtraBold"
                       Foreground="#5A7BD8"/>
            <Border HorizontalAlignment="Right"
                    CornerRadius="18"
                    Background="White"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/find.png"
                           Width="18"
                           Height="18"
                           Margin="0,0,6,0"/>
                    <TextBox Width="210"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Text="Tìm kiếm theo mã hoá đơn"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="20"
                Padding="22"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <Border Background="#5A7BD8"
                            CornerRadius="12"
                            Padding="10"
                            Margin="0,0,0,14">
                        <TextBlock Text="Tạo hoá đơn mới"
                                   FontFamily="{StaticResource Open Sans}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>

                    <TextBlock Text="Tên khách hàng"/>
                    <TextBox x:Name="txtKH"
                             Height="32"
                             Margin="0,6,0,10"/>

                    <TextBlock Text="Địa chỉ"/>
                    <TextBox x:Name="txtDiaChi"
                             Height="32"
                             Margin="0,6,0,10"/>

                    <TextBlock Text="Số điện thoại"/>
                    <TextBox x:Name="txtSDT"
                             Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Background="#41A67E"
                            CornerRadius="12"
                            Padding="10"
                            Margin="0,0,0,10">
                        <TextBlock Text="Danh sách mặt hàng"
                                   FontFamily="{StaticResource Open Sans}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>

                    <Border CornerRadius="12"
                            BorderBrush="#D0D7E2"
                            BorderThickness="1"
                            Background="#FAFAFA"
                            Padding="4">
                        <DataGrid ItemsSource="{Binding OrderDetails}"
                                  
                                  
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Sản phẩm"
                                                        Width="*"
                                                        SelectedItemBinding="{Binding TenSP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <DataGridComboBoxColumn.ItemsSource>
                                        <x:Array Type="sys:String"
                                                 xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                            <sys:String>Thịt bò Mỹ</sys:String>
                                            <sys:String>Cá hồi Nauy</sys:String>
                                            <sys:String>Nước giặt Ariel</sys:String>
                                            <sys:String>Dầu gội Pantene</sys:String>
                                            <sys:String>Chảo Sunhouse</sys:String>
                                            <sys:String>Nồi cơm Sharp</sys:String>
                                            <sys:String>Mì Hảo Hảo</sys:String>
                                            <sys:String>Dầu ăn Simply</sys:String>
                                            <sys:String>Sữa Vinamilk</sys:String>
                                            <sys:String>Sữa chua TH</sys:String>
                                            <sys:String>Choco Pie</sys:String>
                                            <sys:String>Kẹo Haribo</sys:String>
                                            <sys:String>Coca Cola</sys:String>
                                            <sys:String>Bia Heineken</sys:String>
                                            <sys:String>Rau muống</sys:String>
                                            <sys:String>Kem đánh răng PS</sys:String>
                                            <sys:String>Nước rửa chén</sys:String>
                                            <sys:String>Gạo ST25</sys:String>
                                            <sys:String>Bột giặt Omo</sys:String>
                                            <sys:String>Bình Lock&amp;Lock</sys:String>
                                        </x:Array>
                                    </DataGridComboBoxColumn.ItemsSource>
                                </DataGridComboBoxColumn>

                                <DataGridTemplateColumn Header="Số lượng" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SoLuong}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding SoLuong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center"
                                                     HorizontalContentAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <Button Content="Xác nhận"
                                FontFamily="{StaticResource Open Sans}"
                                FontStyle="Normal"
                                Width="130"
                                Height="34"
                                Background="#41A67E"
                                Foreground="White"
                                Click="Button_Click"/>

                        <Button Content="Xóa hóa đơn"
                                FontFamily="{StaticResource Open Sans}"
                                Width="130"
                                Height="34"
                                Margin="0,8,0,0"
                                Background="#DC2626"
                                Foreground="White"
                                BorderThickness="0"
                                Click="Button_Click_1"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="18"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Thông tin hoá đơn"
                           FontFamily="{StaticResource Open Sans}"
                           FontSize="20"
                           FontWeight="ExtraBold"
                           Margin="0,0,0,10"/>

                <Border Grid.Row="1"
                        CornerRadius="12"
                        BorderBrush="#D0D7E2"
                        BorderThickness="1">
                    <DataGrid ItemsSource="{Binding Orders}"
                              SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="None"
                              RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT"
                                                Width="60"
                                                Binding="{Binding STT}"/>
                            <DataGridTextColumn Header="Mã đơn"
                                                Width="100"
                                                Binding="{Binding MaHD}"/>
                            <DataGridTextColumn Header="Tên khách hàng"
                                                Width="160"
                                                Binding="{Binding TenKH}"/>
                            <DataGridTextColumn Header="Địa chỉ"
                                                Width="150"
                                                Binding="{Binding DiaChi}"/>
                            <DataGridTextColumn Header="SDT"
                                                Width="130"
                                                Binding="{Binding SDT}"/>

                            <DataGridTemplateColumn Header="Mặt hàng" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding MatHang}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TenSP}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="SL" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding MatHang}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoLuong}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Thành tiền" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding MatHang}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ThanhTien, StringFormat={}{0:N0}}"
                                                               Foreground="#2563EB"
                                                               FontWeight="SemiBold"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
