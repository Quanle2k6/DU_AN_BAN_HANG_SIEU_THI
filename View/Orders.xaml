<UserControl x:Class="Page_Navigation_App.View.Orders"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Page_Navigation_App.ViewModel"
             Background="#EEF6F4">

    <UserControl.DataContext>
        <vm:OrderVM/>
    </UserControl.DataContext>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="Chi tiết hoá đơn"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#5A7BD8"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Image Source="/Images/find.png"
                       Width="22"
                       Height="22"
                       Margin="0,0,8,0"/>
                <TextBox Width="260"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Text="Tìm kiếm theo mã hoá đơn"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="16"
                Padding="25"
                Margin="0,0,0,25">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,30,0">
                    <TextBlock Text="Tạo hoá đơn mới"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Tên khách hàng" FontWeight="SemiBold"/>
                    <TextBox Height="32" Margin="0,5,0,12"/>

                    <TextBlock Text="Địa chỉ" FontWeight="SemiBold"/>
                    <TextBox Height="32" Margin="0,5,0,12"/>

                    <TextBlock Text="Số điện thoại" FontWeight="SemiBold"/>
                    <TextBox Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Danh sách mặt hàng"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <DataGrid Height="180"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True"
                              ItemsSource="{Binding OrderDetails}"
                              RowHeight="32"
                              HeadersVisibility="Column">

                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Sản phẩm"
                                                    Width="*"
                                                    DisplayMemberPath="TenSP"
                                                    SelectedValuePath="MaSP"
                                                    SelectedValueBinding="{Binding MaSP}"
                                                    ItemsSource="{Binding ProductList}"/>

                            <DataGridTextColumn Header="Số lượng"
                                                Width="120"
                                                Binding="{Binding SoLuong}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,15,0,0">
                        <Button Content="Quay lại"
                                Width="110"
                                Height="36"
                                Background="#F1F1F1"
                                Margin="0,0,10,0"/>
                        <Button Content="Xác nhận"
                                Width="130"
                                Height="36"
                                Background="#41A67E"
                                Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="16"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Thông tin hoá đơn"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <DataGrid x:Name="db1"
                          Grid.Row="1"
                          ItemsSource="{Binding Orders}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}"/>
                        <DataGridTextColumn Header="Mã đơn" Width="100" Binding="{Binding MaHD}"/>
                        <DataGridTextColumn Header="Tên khách hàng" Width="160" Binding="{Binding TenKH}"/>
                        <DataGridTextColumn Header="Địa chỉ" Width="140" Binding="{Binding DiaChi}"/>
                        <DataGridTextColumn Header="SDT" Width="130" Binding="{Binding SDT}"/>

                        <DataGridTemplateColumn Header="Mặt hàng" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding MatHang}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TenSP}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="SL" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding MatHang}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SoLuong}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Thành tiền" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding MatHang}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ThanhTien, StringFormat={}{0:N0}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
