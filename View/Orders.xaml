<UserControl x:Class="Page_Navigation_App.View.Orders"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Page_Navigation_App.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1100"
             Style="{StaticResource Page_Style}">

    <UserControl.DataContext>
        <vm:OrderVM />
    </UserControl.DataContext>

    <Grid Margin="10,10,0,0" HorizontalAlignment="Left" Width="935" RenderTransformOrigin="0.503,0.528">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="Chi tiết hoá đơn" HorizontalAlignment="Left" Height="67" Margin="10,-16,0,0" VerticalAlignment="Top" Width="513" FontSize="36" Foreground="#647FBC" FontWeight="Bold" />
        <Label Content="Thông tin hoá đơn" HorizontalAlignment="Left" Margin="18,321,0,0" VerticalAlignment="Top" Width="172" FontSize="18" FontWeight="Bold" RenderTransformOrigin="0.499,-0.194"/>
        <ListView Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="268" Margin="0,360,0,0" VerticalAlignment="Top" Width="848" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="STT" Width="30"/>
                    <GridViewColumn Header="Mã đơn" Width="60"/>
                    <GridViewColumn Header="Tên khách hàng" Width="150"/>
                    <GridViewColumn Header="Địa chỉ" Width="160"/>
                    <GridViewColumn Header="Số điện thoại" Width="90"/>
                    <GridViewColumn Header="Danh sách mặt hàng đã mua" Width="220"/>
                    <GridViewColumn Header="SL" Width="40"/>
                    <GridViewColumn Header="Thành tiền" Width="95"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Label Content="Tên khách hàng" HorizontalAlignment="Left" Height="40" Margin="38,119,0,0" VerticalAlignment="Top" Width="132" FontSize="16" FontWeight="Bold" RenderTransformOrigin="0.519,1.587"/>
        <Label Content="Địa chỉ" HorizontalAlignment="Left" Height="33" Margin="38,169,0,0" VerticalAlignment="Top" Width="115" FontSize="16" FontWeight="Bold" RenderTransformOrigin="0.533,-0.588"/>
        <Label Content="Số điện thoại" HorizontalAlignment="Left" Height="35" Margin="38,215,0,0" VerticalAlignment="Top" Width="115" FontSize="16" FontWeight="Bold"/>
        <TextBox HorizontalAlignment="Left" Margin="200,124,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="209" Height="26"/>
        <TextBox HorizontalAlignment="Left" Height="29" Margin="200,168,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="209"/>
        <TextBox HorizontalAlignment="Left" Height="29" Margin="200,215,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="209"/>
        <ListBox HorizontalAlignment="Left" Height="0" Margin="549,150,0,0" VerticalAlignment="Top" Width="15" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <Label Content="Tạo hoá đơn mới:" HorizontalAlignment="Left" Height="42" Margin="38,77,0,0" VerticalAlignment="Top" Width="170" FontSize="16" FontWeight="Bold"/>
        <Label Content="Danh sách mặt hàng" HorizontalAlignment="Left" Height="36" Margin="493,124,0,0" VerticalAlignment="Top" Width="171" RenderTransformOrigin="0.449,1.119" FontSize="16" FontWeight="Bold"/>
        <ComboBox Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="682,130,0,0" VerticalAlignment="Top" Width="172" Height="30"/>
        <Label Content="Số lượng" HorizontalAlignment="Left" Height="34" Margin="493,169,0,0" VerticalAlignment="Top" Width="106" FontSize="16" FontWeight="Bold" RenderTransformOrigin="0.59,0.494"/>
        <TextBox HorizontalAlignment="Left" Height="32" Margin="736,182,0,0" TextWrapping="Wrap" 
                 Text="" VerticalAlignment="Top" Width="43" FontSize="16" FontWeight="Bold" RenderTransformOrigin="0.484,0.538"/>
        <Button  HorizontalAlignment="Left" Margin="670,181,0,0" 
                VerticalAlignment="Top" Width="48" Height="29"
                BorderBrush="Transparent" BorderThickness="0" Background="Transparent">
            <Image Source="/Images/minus.png" Width="48" Height="29"
                       Opacity="0.7" />
        </Button>
        <Button Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="29" Margin="800,185,0,0"
                VerticalAlignment="Top" Width="48" RenderTransformOrigin="0.95,0.503"
                BorderBrush="Transparent" BorderThickness="0" Background="Transparent">
            <Image Source="/Images/plus.png"  Width="48" Height="29"
                       Opacity="0.7"
                   />
        </Button>
        <Button Margin="668,236,97,579" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0.849"/>
                    <RotateTransform/>
                    <TranslateTransform X="-1.185"/>
                </TransformGroup>
            </Button.RenderTransform>
            <Image Source="/Images/1486564411-checkmark_81522.png" Width="20" Height="20" 
               VerticalAlignment="Center"
                   />
        </Button>
        <Button Content="Quay lại" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="35" Margin="740,226,0,0" VerticalAlignment="Top" Width="114" FontSize="16" FontWeight="Bold"/>
        <Button Content="Xác nhận lập hoá đơn" HorizontalAlignment="Left" Height="38" Margin="625,291,0,0" VerticalAlignment="Top" Width="221" FontSize="16" FontWeight="Bold" Grid.ColumnSpan="2"/>
        <Grid HorizontalAlignment="Left" Height="44" Margin="523,36,0,0" VerticalAlignment="Top" Width="295" RenderTransformOrigin="0.481,0.956">
            <Button HorizontalAlignment="Left" Height="34" VerticalAlignment="Center" Width="44" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="0">
                <Image Source="/Images/find.png"
                           Width="25" Height="25"
                           Opacity="0.7" />
            </Button>
            <TextBox x:Name="txtSearch" HorizontalAlignment="Left" Height="34" Margin="44,0,0,0" TextWrapping="Wrap" Text="Tìm kiếm theo mã hoá đơn"
                     VerticalAlignment="Center" Width="251" TextChanged="TextBox_TextChanged" FontSize="16"
                     Foreground="#FF6D1F"
                     GotFocus="txtBox_GotFocus" 
                     LostFocus="txtBox_LostFocus"/>
        </Grid>
        <Grid HorizontalAlignment="Left" Height="40" Margin="38,669,0,0" VerticalAlignment="Top" Width="287" RenderTransformOrigin="0.501,0.528">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="209*"/>
                <ColumnDefinition Width="78*"/>
            </Grid.ColumnDefinitions>
            <Button HorizontalAlignment="Left" Height="40" VerticalAlignment="Center" Width="56"
                    BorderBrush="Transparent" BorderThickness="0" Background="Transparent">
                <Image Source="/Images/bin-file.png" Width="48" Height="30"
                       Opacity="0.7" />
            </Button>
            <TextBox Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="40" Margin="61,0,0,0" TextWrapping="Wrap"
                     Text="Xoá theo mã hoá đơn" VerticalAlignment="Center" Width="226" FontSize="16"
                    />
        </Grid>
        <Button Content="Xoá dữ liệu theo ngày" HorizontalAlignment="Left" Height="35" Margin="670,647,0,0" VerticalAlignment="Top" Width="184" Grid.ColumnSpan="2" FontSize="16" FontWeight="Bold"/>


    </Grid>
</UserControl>
