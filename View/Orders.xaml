<UserControl x:Class="Page_Navigation_App.View.Orders"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Page_Navigation_App.ViewModel"
             Background="#EEF6F4">

    <UserControl.DataContext>
        <vm:OrderVM/>
    </UserControl.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Chi tiết hoá đơn"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#5A7BD8"/>

            <Border HorizontalAlignment="Right"
                    CornerRadius="18"
                    Background="White"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/find.png"
                           Width="18"
                           Height="18"
                           Margin="0,0,6,0"/>
                    <TextBox Width="210"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Text="Tìm kiếm theo mã hoá đơn"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Create order -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="20"
                Padding="22"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <Border Background="#5A7BD8"
                            CornerRadius="12"
                            Padding="10"
                            Margin="0,0,0,14">
                        <TextBlock Text="Tạo hoá đơn mới"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>

                    <TextBlock Text="Tên khách hàng"/>
                    <TextBox Height="32" Margin="0,6,0,10"/>

                    <TextBlock Text="Địa chỉ"/>
                    <TextBox Height="32" Margin="0,6,0,10"/>

                    <TextBlock Text="Số điện thoại"/>
                    <TextBox Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Background="#41A67E"
                            CornerRadius="12"
                            Padding="10"
                            Margin="0,0,0,10">
                        <TextBlock Text="Danh sách mặt hàng"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>

                    <Border CornerRadius="12"
                            BorderBrush="#D0D7E2"
                            BorderThickness="1"
                            Background="#FAFAFA"
                            Padding="4">

                        <DataGrid Height="150"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  ItemsSource="{Binding OrderDetails}"
                                  RowHeight="34"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  IsReadOnly="False"
                                  Background="Transparent">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EEF2F7"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Height" Value="36"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Sản phẩm"
                                                        Width="*"
                                                        DisplayMemberPath="TenSP"
                                                        SelectedValuePath="MaSP"
                                                        SelectedValueBinding="{Binding MaSP, Mode=TwoWay}"
                                                        ItemsSource="{Binding DataContext.ProductList,
                                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                <DataGridTextColumn Header="Số lượng"
                                                    Width="110"
                                                    Binding="{Binding SoLuong, Mode=TwoWay}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <Button Content="Quay lại"
                                Width="110"
                                Height="34"
                                Background="#E5E7EB"
                                Margin="0,0,10,0"/>
                        <Button Content="Xác nhận"
                                Width="130"
                                Height="34"
                                Background="#41A67E"
                                Foreground="White"
                                Click="Button_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Invoice info -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="18"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Thông tin hoá đơn"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Border Grid.Row="1"
                        CornerRadius="12"
                        BorderBrush="#D0D7E2"
                        BorderThickness="1">

                    <DataGrid ItemsSource="{Binding Orders}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="None"
                              RowHeight="32">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}"/>
                            <DataGridTextColumn Header="Mã đơn" Width="100" Binding="{Binding MaHD}"/>
                            <DataGridTextColumn Header="Tên khách hàng" Width="160" Binding="{Binding TenKH}"/>
                            <DataGridTextColumn Header="Địa chỉ" Width="150" Binding="{Binding DiaChi}"/>
                            <DataGridTextColumn Header="SDT" Width="130" Binding="{Binding SDT}"/>

                            <DataGridTemplateColumn Header="Mặt hàng" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding MatHang}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TenSP}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="SL" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding MatHang}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoLuong}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Thành tiền" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding MatHang}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ThanhTien, StringFormat={}{0:N0}}"
                                                               Foreground="#2563EB"
                                                               FontWeight="SemiBold"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
