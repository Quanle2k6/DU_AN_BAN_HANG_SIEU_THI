<UserControl x:Class="Page_Navigation_App.View.Orders"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Page_Navigation_App.ViewModel"
             Background="#EEF6F4">

    <UserControl.DataContext>
        <vm:OrderVM/>
    </UserControl.DataContext>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="Chi tiết hoá đơn"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#5A7BD8"/>

            <Border HorizontalAlignment="Right"
                    CornerRadius="20"
                    Background="White"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/find.png"
                           Width="20"
                           Height="20"
                           Margin="0,0,8,0"/>
                    <TextBox Width="230"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Text="Tìm kiếm theo mã hoá đơn"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="20"
                Padding="30"
                Margin="0,0,0,25">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,30,0">
                    <TextBlock Text="Tạo hoá đơn mới"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Tên khách hàng"/>
                    <TextBox Height="36" Margin="0,6,0,14"/>

                    <TextBlock Text="Địa chỉ"/>
                    <TextBox Height="36" Margin="0,6,0,14"/>

                    <TextBlock Text="Số điện thoại"/>
                    <TextBox Height="36"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Danh sách mặt hàng"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <Border CornerRadius="12"
                            BorderBrush="#D0D7E2"
                            BorderThickness="1">

                        <DataGrid Height="190"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  ItemsSource="{Binding OrderDetails}"
                                  RowHeight="34"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  IsReadOnly="False">

                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Sản phẩm"
                                                        Width="*"
                                                        DisplayMemberPath="TenSP"
                                                        SelectedValuePath="MaSP"
                                                        SelectedValueBinding="{Binding MaSP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ItemsSource="{Binding DataContext.ProductList,
                                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                <DataGridTextColumn Header="Số lượng"
                                                    Width="120"
                                                    Binding="{Binding SoLuong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">
                        <Button Content="Quay lại"
                                Width="120"
                                Height="38"
                                Background="#F1F1F1"
                                Margin="0,0,12,0"/>
                        <Button Content="Xác nhận"
                                Width="140"
                                Height="38"
                                Background="#41A67E"
                                Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="20"
                Padding="25">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Thông tin hoá đơn"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <Border Grid.Row="1"
                        CornerRadius="12"
                        BorderBrush="#D0D7E2"
                        BorderThickness="1">

                    <DataGrid ItemsSource="{Binding Orders}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="None"
                              RowHeight="34">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}"/>
                            <DataGridTextColumn Header="Mã đơn" Width="100" Binding="{Binding MaHD}"/>
                            <DataGridTextColumn Header="Tên khách hàng" Width="160" Binding="{Binding TenKH}"/>
                            <DataGridTextColumn Header="Địa chỉ" Width="150" Binding="{Binding DiaChi}"/>
                            <DataGridTextColumn Header="SDT" Width="130" Binding="{Binding SDT}"/>

                            <DataGridTemplateColumn Header="Mặt hàng" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding MatHang}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TenSP}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="SL" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding MatHang}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SoLuong}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Thành tiền" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding MatHang}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ThanhTien, StringFormat={}{0:N0}}"
                                                               Foreground="#2E86FF"
                                                               FontWeight="SemiBold"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
