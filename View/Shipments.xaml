<UserControl x:Class="Page_Navigation_App.View.Shipments"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Page_Navigation_App.ViewModel"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1300"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Style="{StaticResource Page_Style}"
             >

    <UserControl.DataContext>
        <vm:ShipmentVM/>
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
               Content="Báo cáo doanh thu"
               FontSize="30"
               FontWeight="Black"
               FontFamily="Javanese Text"
               Foreground="#5A7BD8"/>

        <UniformGrid Grid.Row="1" Columns="3" Height="150" Margin="0,10">
            <Border Background="#FF3838" Margin="5" CornerRadius="8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalOrders}"
                               FontSize="32"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"/>
                    <Label Content="Số đơn hàng trong ngày"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="#C47BE4" Margin="5" CornerRadius="8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding RevenueByDate}"
                               FontSize="32"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"/>
                    <Label Content="Doanh thu theo ngày"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="#9CC6DB" Margin="5" CornerRadius="8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding RevenueByMonth}"
                               FontSize="32"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"/>
                    <Label Content="Doanh thu theo tháng"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <Label Content="Chọn ngày thống kê"
                       FontSize="18"
                       FontWeight="Black"
                       FontFamily="Javanese Text"/>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <DatePicker Width="180"
                                SelectedDate="{Binding SelectedDate}"
                                Margin="0,0,10,0"/>

                    <Button Content="Xác nhận"
                            Width="124"
                            Command="{Binding LoadAllStatisticCommand}"
                            Background="#FCF6D9"
                            FontWeight="Bold" Height="30"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <lvc:CartesianChart Grid.Column="0"
                                    Series="{Binding RevenueByDaySeries}"
                                    LegendLocation="Bottom"
                                    Margin="10">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Title="Thứ"
                                  Labels="{Binding Days}"/>
                    </lvc:CartesianChart.AxisX>

                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="Doanh thu"
                                  LabelFormatter="{Binding YFormatter}"
                                  MinValue="0"/>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>

                <lvc:CartesianChart Grid.Column="1"
                                    Series="{Binding ThongKeTheoQuy}"
                                    LegendLocation="Bottom"
                                    Margin="10">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Title="Quý"
                                  Labels="{Binding Quarters}"/>
                    </lvc:CartesianChart.AxisX>

                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="Doanh thu"
                                  LabelFormatter="{Binding YFormatter}"
                                  MinValue="0"/>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
