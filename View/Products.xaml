<UserControl x:Class="Page_Navigation_App.View.Products"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Page_Navigation_App.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Style="{StaticResource Page_Style}">

    <UserControl.DataContext>
        <vm:ProductVM />
    </UserControl.DataContext>

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Danh mục khuyến mại"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#5A7BD8"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="5"
                Padding="15"
                Margin="0,0,0,20">

            <StackPanel Orientation="Horizontal">

                <Button Content="Thêm khuyến mại"
                        Command="{Binding AddKhuyenMaiCommand}"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="15,8"
                        BorderThickness="0" Click="Button_Click"/>

                <Button Content="Xóa khuyến mại"
                        Command="{Binding DeleteKhuyenMaiCommand}"
                        Background="#2196F3"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="15,8"
                        BorderThickness="0"
                        Margin="10,0,0,0"/>

            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="5"
                Padding="15"
                Margin="0,0,0,20">

            <StackPanel>

                <TextBlock Text="Nhập khuyến mãi mới"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã khuyến mãi"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewMaKM}"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Tên khuyến mãi"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding NewTenKM}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ngày bắt đầu"/>
                    <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding NewNgayBD}"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Ngày kết thúc"/>
                    <DatePicker Grid.Row="2" Grid.Column="3" SelectedDate="{Binding NewNgayKT}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Phần trăm giảm"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding NewPhanTramGiam}"/>

                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Áp dụng (1 / 0)"/>
                    <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding NewApDung}"/>
                </Grid>

            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3"
          ItemsSource="{Binding StockItems}"
          SelectedItem="{Binding SelectedKhuyenMai}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True"
          SelectionMode="Single"
          GridLinesVisibility="None"
          RowHeight="45"
          FontSize="14"
          BorderThickness="1"
          BorderBrush="#E0E0E0"
          HeadersVisibility="Column">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Mã khuyến mãi"
                            Binding="{Binding ProductId}"
                            Width="120">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#87BAC3"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="10,12"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Tên khuyến mãi"
                            Binding="{Binding ProductName}"
                            Width="*">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#87BAC3"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="15,12"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Ngày bắt đầu"
                            Binding="{Binding StartDate,StringFormat=dd/MM/yyyy}"
                            Width="150">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#87BAC3"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Ngày kết thúc"
                            Binding="{Binding EndDate,StringFormat=dd/MM/yyyy}"
                            Width="150">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#87BAC3"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Phần trăm giảm"
                                Width="180">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#87BAC3"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding DiscountColor}"
                            CornerRadius="4"
                            Margin="10,5"
                            Height="30">
                                <TextBlock Text="{Binding DiscountPercentage,StringFormat='{}{0}%'}"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Trạng thái"
                                Width="130">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#87BAC3"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusColor}"
                            CornerRadius="4"
                            Margin="10,5"
                            Height="30">
                                <TextBlock Text="{Binding Status}"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F5F5F5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

        </DataGrid>

    </Grid>
</UserControl>
