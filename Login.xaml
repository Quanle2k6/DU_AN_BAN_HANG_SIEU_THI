<Window x:Class="Page_Navigation_App.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Page_Navigation_App.View"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="RoundedInputStyle" TargetType="Control">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Open Sans}"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Background" Value="#87BAC3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" ClipToBounds="True" Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="313"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Border CornerRadius="20,0,0,20" ClipToBounds="True">
                    <Image Source="/Images/supermarket.webp" 
                           Stretch="UniformToFill" 
                           HorizontalAlignment="Center" Width="475" Margin="0,21,0,21"/>
                </Border>

                <Border CornerRadius="20,0,0,20" Opacity="0.5" Margin="0,0,-48,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="Blue" Offset="0.0" />
                            <GradientStop Color="Black" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="#213448" CornerRadius="0,20,20,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel Margin="40,30,40,30">
                    <Image Source="/Images/logo.png" Height="54" Width="156" 
                           />
                    <TextBlock Text="ĐĂNG NHẬP" Foreground="White" FontSize="30" 
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <TextBlock Text="Tên tài khoản:" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <TextBox x:Name="txtUser" Style="{StaticResource RoundedInputStyle}"/>

                    <TextBlock Text="Mật khẩu:" Foreground="White" Margin="0,15,0,5" FontWeight="Bold"/>
                    <PasswordBox x:Name="txtPass" Style="{StaticResource RoundedInputStyle}"/>

                    <TextBox x:Name="txtPassVisible" Style="{StaticResource RoundedInputStyle}" 
                             Visibility="Collapsed"/>

                    <CheckBox x:Name="chkShowPass" Content="Hiển thị mật khẩu" 
                              Foreground="White" Margin="0,15,0,0" 
                              Checked="chkShowPass_Checked" Unchecked="chkShowPass_Unchecked"/>

                    <Button Content="Đăng nhập" Margin="0,40,0,0" Height="40" 
                            Style="{StaticResource RoundedButtonStyle}"
                            Click="btnLogin_Click"/>
                </StackPanel>
            </Border>

            <Button x:Name="CloseApp" Style="{StaticResource ExitApp}" 
                    Click="CloseApp_Click" HorizontalAlignment="Right" 
                    VerticalAlignment="Top" Margin="0,15,15,0" Grid.Column="1"/>
        </Grid>
    </Border>
</Window>